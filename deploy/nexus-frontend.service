# Frontend Next.js de Nexus.
# Requiere `npm ci && npm run build` previo: el build standalone deja el
# servidor en .next/standalone/server.js
[Unit]
Description=Nexus Frontend (Next.js)
After=network.target nexus-backend.service
Wants=nexus-backend.service

[Service]
Type=simple
User=nexus
Group=nexus
# server.js resuelve .next/static y public/ relativos a su propio directorio,
# así que el WorkingDirectory debe ser standalone, no frontend/.
WorkingDirectory=/opt/nexus/frontend/.next/standalone
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# Con `output: standalone` hay que arrancar este server.js, no `next start`.
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
